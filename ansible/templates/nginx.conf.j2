# {{ ansible_managed }} — OAuth redirects arrive from the user's browser, not provider egress.
limit_req_zone $binary_remote_addr zone=datamcp:1m rate=10r/s;
{% macro proxy() %}
        proxy_pass http://127.0.0.1:{{ datamcp_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
{% endmacro %}
server {
    listen 80;
    server_name {{ datamcp_domain }};
    return 301 https://{{ datamcp_domain }}$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name {{ datamcp_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ datamcp_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ datamcp_domain }}/privkey.pem;
    access_log /var/log/nginx/data-mcp.access.log;
    error_log /var/log/nginx/data-mcp.error.log;
{% if datamcp_deny_all %}
    return 403;
{% endif %}
    limit_req zone=datamcp burst=20 nodelay;
    client_max_body_size 1m;

    location = /healthz {
{% for ip in datamcp_admin_ips %}
        allow {{ ip }};
{% endfor %}
        deny all;
{{ proxy() }}
    }
    location /mcp {
{% for cidr in anthropic_egress_cidrs + openai_egress_cidrs + datamcp_admin_ips %}
        allow {{ cidr }};
{% endfor %}
        deny all;
{{ proxy() }}
    }
    # Discovery, registration, authorization, consent and callbacks must be browser-accessible.
    # Google sign-in and the account allowlist remain mandatory before any data access.
    location / {
{{ proxy() }}
    }
}

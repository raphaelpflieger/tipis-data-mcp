# tipis-data-mcp configuration (rendered by ansible/templates/env.j2 in production).
# Non-secret settings only: secrets are FILES under ./secrets (see *_FILE below).
DATAMCP_BASE_URL=https://data-mcp.tipis.com
DATAMCP_MCP_PATH=/mcp
DATAMCP_PORT=8765
# kill switch: 0 makes every tool answer "disabled" (auth and healthz keep working)
DATAMCP_ENABLED=1

# Google OAuth client (Google Cloud console → APIs & Services → Credentials, type Web application,
# redirect URI https://data-mcp.tipis.com/auth/callback, publishing status Testing, test users =
# the allowed accounts). The secret is a file.
DATAMCP_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
DATAMCP_GOOGLE_CLIENT_SECRET_FILE=/secrets/google_client_secret
# FastMCP token signing key (any long random string: openssl rand -base64 48)
DATAMCP_JWT_SIGNING_KEY_FILE=/secrets/jwt_signing_key
# Fernet key of the OAuth state store (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DATAMCP_STORAGE_KEY_FILE=/secrets/storage_key
DATAMCP_STORAGE_DIR=/data/oauth
# MCP clients allowed to receive authorization codes (claude.ai, plus loopback for local testing)
DATAMCP_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect
DATAMCP_REQUIRE_CONSENT=1

# Who may use the connector: one Google account per line, hot-reloaded
DATAMCP_ALLOWLIST_FILE=/secrets/allowed_emails.txt
DATAMCP_AUDIT_DIR=/logs

# Query limits
DATAMCP_QUERY_TIMEOUT_S=60
DATAMCP_MAX_ROWS=1000
DATAMCP_MAX_RESULT_CHARS=60000
DATAMCP_MAX_CONCURRENT_QUERIES=3
DATAMCP_MAX_QUERIES_PER_USER=1
# MCP-level throttle (requests per second, burst) on top of nginx's limit_req
DATAMCP_RATE_LIMIT_RPS=5
DATAMCP_RATE_LIMIT_BURST=20
DATAMCP_CATALOG_TTL_S=3600

# Primary database (tipis-db-1 over WireGuard, role tipis_analytics, TLS pinned on the cluster CA)
DATAMCP_PRIMARY_DB_HOST=10.88.0.1
DATAMCP_PRIMARY_DB_PORT=5432
DATAMCP_PRIMARY_DB_NAME=tipis_production
DATAMCP_PRIMARY_DB_USER=tipis_analytics
DATAMCP_PRIMARY_DB_PASSWORD_FILE=/secrets/primary_db_password
DATAMCP_PRIMARY_DB_SSLMODE=verify-full
DATAMCP_PRIMARY_DB_SSLROOTCERT=/certs/tipis-ca.crt

# Metrics database (tipis-photos, public IP + TLS pinned on the metrics CA)
DATAMCP_METRICS_DB_HOST=51.210.105.166
DATAMCP_METRICS_DB_PORT=16452
DATAMCP_METRICS_DB_NAME=tipis_timescale_metrics
DATAMCP_METRICS_DB_USER=tipis_analytics
DATAMCP_METRICS_DB_PASSWORD_FILE=/secrets/metrics_db_password
DATAMCP_METRICS_DB_SSLMODE=verify-full
DATAMCP_METRICS_DB_SSLROOTCERT=/certs/tipis-metrics-ca.crt
